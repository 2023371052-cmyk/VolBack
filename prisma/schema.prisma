datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- ENUMS PARA RESTRICCIONES ---
enum UserRole {
  client
  admin
}
model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(client)
  createdAt    DateTime @default(now()) @map("created_at")
  avatarUrl    String?  @default("/avatars/hombre1.jpg") @map("avatar_url") @db.VarChar(255)

  cartItems    CartItem[]
  orders       Order[]
  wishlists    Wishlist[]

  @@map("users")
}

model Avatar {
  id       Int     @id @default(autoincrement())
  nombre   String  @db.VarChar(100)
  imageUrl String  @map("image_url") @db.VarChar(255)
  activo   Boolean @default(true)

  @@map("avatars")
}

model Product {
  id                 Int      @id @default(autoincrement())
  name               String   @db.VarChar(150)
  sku                String?  @db.VarChar(100)
  description        String?  @db.Text
  price              Decimal  @db.Decimal(10, 2)
  stock              Int      @default(0)
  marca              String?  @db.VarChar(100)
  category           String   @default("Supercargadores") @db.VarChar(100)
  tipo_supercargador String?  @db.VarChar(100)
  nivel_kit          String?  @db.VarChar(100)
  plataforma_motor   String?  @db.VarChar(150)
  rango_anio         String?  @db.VarChar(100)
  potencia_max       String?  @db.VarChar(100)
  boost_base         String?  @db.VarChar(100)
  enfriamiento       String?  @db.VarChar(100)
  disponibilidad     String?  @db.VarChar(100)
  tiempo_entrega     String?  @db.VarChar(100)
  incluye_caja       String?  @db.Text
  notas_instalacion  String?  @db.Text
  imageUrl           String?  @map("image_url") @db.VarChar(255)
  createdAt          DateTime @default(now()) @map("created_at")

  cartItems          CartItem[]
  orderDetails       OrderDetail[]
  wishlists          Wishlist[]
  manual             ProductManual?

  @@map("products")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  productId Int?     @map("product_id")
  quantity  Int      @default(1)
  addedAt   DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

model Order {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  totalAmount Decimal  @map("total_amount") @db.Decimal(10, 2)
  status      String?  @default("completed") @db.VarChar(50)
  receiptUrl  String?  @map("receipt_url") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderDetails OrderDetail[]

  @@map("orders")
}

model OrderDetail {
  id        Int     @id @default(autoincrement())
  orderId   Int?    @map("order_id")
  productId Int?    @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_details")
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  productId Int?     @map("product_id")
  addedAt   DateTime @default(now()) @map("added_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("wishlists")
}

model Notification {
  id             Int      @id @default(autoincrement())
  titulo         String   @db.VarChar(150)
  mensaje        String   @db.Text
  horaProgramada String   @db.VarChar(50)
  tipo           String   @default("push") @db.VarChar(50)
  leida          Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model ProductManual {
  id            Int      @id @default(autoincrement())
  productId     Int      @unique @map("product_id")
  title         String   @db.VarChar(180)
  manualUrl     String   @map("manual_url") @db.VarChar(500)
  fileName      String?  @map("file_name") @db.VarChar(255)
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_manuals")
}